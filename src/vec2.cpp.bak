#include <vector>
#include <stdexcept>


vec2::vec2() : x(0.0), y(0.0) {}

vec2::vec2(double val_x, double val_y) : x(val_x), y(val_y) {}

vec2& vec2::operator+=(const vec2& rhs) {
    x += rhs.x;
    y += rhs.y;
    return *this;
}

vec2& vec2::operator-=(const vec2& rhs) {
    x -= rhs.x;
    y -= rhs.y;
    return *this;
}

double& vec2::operator[](int index) {
    if (index == 0) return x;
    if (index == 1) return y;
    throw std::out_of_range("Index out of bounds for vec2. Must be 0 or 1.");
}

const double& vec2::operator[](int index) const {
    if (index == 0) return x;
    if (index == 1) return y;
    throw std::out_of_range("Index out of bounds for vec2. Must be 0 or 1.");
}

vec2 operator+(const vec2& lhs, const vec2& rhs) {
    vec2 result = lhs;
    result += rhs;
    return result;
}

vec2 operator-(const vec2& lhs, const vec2& rhs) {
    vec2 result = lhs;
    result -= rhs;
    return result;
}

vec2 operator*(const vec2& vec, double scalar) {
    return vec2(vec.x * scalar, vec.y * scalar);
}

vec2 operator*(double scalar, const vec2& vec) {
    return vec * scalar;
}

vec2 operator/(const vec2& vec, double scalar) {
    return vec2(vec.x / scalar, vec.y / scalar);
}